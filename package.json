{
  "name": "nscore",
  "version": "2.1.0",
  "description": "A production-ready Discord app core built with TypeScript and Discord.js.",
  "main": "dist/index.js",
  "types": "types/index.d.ts",
  "scripts": {
    "test": "vitest run --environment node --pool=threads",
    "test:watch": "vitest --environment node --pool=threads",
    "test:coverage": "vitest run --environment node --pool=threads --coverage --coverage.clean=false --coverage.reportsDirectory=coverage/vitest",
    "clean": "rimraf dist types",
    "build": "npx tsc",
    "format:check": "npx prettier . --check",
    "format:write": "npx prettier . --write",
    "deploy": "node dist/utils/deployCommands.js",
    "start": "node dist/index.js",
    "execute": "npm run clean && npm run build && npm run format:write && npm run start",
    "cleanStart": "npm run clean && npm run build && npm run start",
    "noCleanStart": "npm run build && npm run start",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "release": "cliff-jumper"
  },
  "keywords": [
    "nsCore",
    "discord"
  ],
  "author": "nsgpriyanshu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nsgpriyanshu/nscore",
    "homepage": "https://github.com/nsgpriyanshu/nscore#readme",
    "bugs": {
      "url": "https://github.com/nsgpriyanshu/nscore/issues"
    }
  },
  "dependencies": {
    "@types/ws": "^8.5.10",
    "autoprefixer": "^10.4.20",
    "axios": "^1.7.7",
    "discord.js": "^14.18.0",
    "dotenv": "^16.4.5",
    "greetify": "^2.0.1",
    "node-fetch": "^3.3.2",
    "nstypocolors": "^2.0.4",
    "typescript": "^5.5.2"
  },
  "devDependencies": {
    "@favware/cliff-jumper": "^3.0.3",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/release-notes-generator": "^14.0.1",
    "@types/node": "^22.5.2",
    "@typescript-eslint/eslint-plugin": "8.59.2",
    "@typescript-eslint/parser": "8.59.2",
    "@vitest/coverage-v8": "4.1.5",
    "eslint": "^9.9.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-node": "11.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "prettier": "^3.3.2",
    "semantic-release": "^21.1.2",
    "vitest": "4.1.5"
  }
}
